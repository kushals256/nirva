{
  "buildCommand": "node scripts/inject-config.js",
  "outputDirectory": "frontend",
  "framework": null,
  "installCommand": "npm install --ignore-scripts",
  "rewrites": [
    { "source": "/static/:path*", "destination": "/:path*" },
    { "source": "/((?!.*\\.).*)", "destination": "/index.html" }
  ]
}
